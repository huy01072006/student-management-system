{
  "title": "Student Management Monitoring",
  "uid": "student-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Prometheus Status",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {"expr": "up{job=\"student-prometheus\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "1": {"text": "UP", "color": "green"},
              "0": {"text": "DOWN", "color": "red"}
            }}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Prometheus HTTP Requests",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(prometheus_http_requests_total[5m])", "refId": "A"}
      ]
    }
  ]
}
